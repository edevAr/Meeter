# AI / LLM: qwen3 | groq | gemini | openai | ollama | local
# Qwen3: if AI_API_KEY starts with gsk_ (Groq), Meeter uses Groq's qwen/qwen3-32b.
# Without a key, it tries local Ollama (`ollama pull qwen3`) and then the on-device summarizer.
AI_PROVIDER=qwen3
AI_API_KEY=
AI_MODEL=qwen3
AI_BASE_URL=

# Transcription: faster-whisper | whisper | openai (cloud, requires explicit opt-in)
# Docker Compose uses faster-whisper (CPU, local, no Python install on the host).
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=tiny
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Speaker diarization: clustering (default, local) | pyannote | none
# pyannote needs `pip install pyannote.audio` and a Hugging Face token.
DIARIZATION_PROVIDER=clustering
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
HF_TOKEN=

# Privacy: never send audio to an external STT provider unless true
ALLOW_CLOUD_TRANSCRIPTION=false

# Database (SQLAlchemy URL). Swap to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ai_call_recorder
DATABASE_URL=sqlite:///./data/app.db

# Storage
RECORDINGS_PATH=./data/recordings
TRANSCRIPTS_PATH=./data/transcripts
EXPORTS_PATH=./data/exports

# Audio capture
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SAMPLE_WIDTH=2
DEFAULT_LANGUAGE=auto

# Limits
MAX_RECORDING_BYTES=524288000
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
